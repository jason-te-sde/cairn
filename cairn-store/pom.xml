  <artifactId>cairn-store</artifactId>
  <name>cairn-store</name>
  <description>
    Durability: a crash-recoverable append-only command log, snapshots, and a content-addressed
    blob store that computes a digest while it writes rather than believing one it was handed.
  </description>

