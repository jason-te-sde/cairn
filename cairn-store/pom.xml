      <groupId>io.github.jason-te-sde</groupId>
      <artifactId>cairn-core</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.jason-te-sde</groupId>
      <artifactId>cairn-codec</artifactId>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>
  </dependencies>
</project>
