<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.github.jason-te-sde</groupId>
    <artifactId>cairn-parent</artifactId>
    <version>0.1.0</version>
  </parent>

  <artifactId>cairn-server</artifactId>
  <name>cairn-server</name>
  <description>
    The whole registry as one process: an HTTP API, Prometheus metrics, and cairnctl. No web
    framework and no JSON library, because the API surface is small enough that a strict parser
    written for it is less risk than a permissive one written for everybody.
  </description>

  <dependencies>
    <dependency>
      <groupId>io.github.jason-te-sde</groupId>
      <artifactId>cairn-core</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.jason-te-sde</groupId>
      <artifactId>cairn-codec</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.jason-te-sde</groupId>
      <artifactId>cairn-store</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.jason-te-sde</groupId>
      <artifactId>cairn-effects</artifactId>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>
    <!-- A binding, at runtime only: a library must not choose one for its embedder, but the
         executable jar is not a library and a server with no binding logs nothing at all. -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>io.github.jason-te-sde</groupId>
      <artifactId>cairn-testkit</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <transformer
                    implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>io.cairn.server.Main</mainClass>
                </transformer>
                <!-- So the executable jar carries its own licence and the licence of the one thing
                     it bundles. A fat jar that ships somebody else's code without their licence is
                     a licence violation, however small the dependency list is. -->
                <transformer
                    implementation="org.apache.maven.plugins.shade.resource.IncludeResourceTransformer">
                  <resource>META-INF/LICENSE</resource>
                  <file>${project.basedir}/../LICENSE</file>
                </transformer>
                <transformer
                    implementation="org.apache.maven.plugins.shade.resource.IncludeResourceTransformer">
                  <resource>META-INF/NOTICE</resource>
                  <file>${project.basedir}/../NOTICE</file>
                </transformer>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <!-- Signature files from a dependency describe that dependency's jar, not the
                         shaded one, so leaving them in produces a jar the JVM refuses to verify. -->
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>

                    <!-- Every jar has a manifest and the transformer above writes the real one, so
                         the rest are an overlap that the plugin warns about on every build. A build
                         with a standing warning is a build nobody reads the warnings of. -->
                    <exclude>META-INF/MANIFEST.MF</exclude>

                    <!-- Both forms. A multi-release jar puts its descriptor under
                         META-INF/versions/<n>/, which the unqualified pattern does not match —
                         which is why the warning survived the first attempt at silencing it. A
                         shaded jar is not a module either way. -->
                    <exclude>module-info.class</exclude>
                    <exclude>META-INF/versions/*/module-info.class</exclude>

                    <!-- Attribution for what is bundled lives in NOTICE, which is included below.
                         Merging several dependencies' LICENSE files into one path would keep
                         whichever happened to be last, which is worse than saying it explicitly. -->
                    <exclude>META-INF/LICENSE*</exclude>
                    <exclude>META-INF/NOTICE*</exclude>
                    <exclude>META-INF/DEPENDENCIES</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
